<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="liferise_database.db" />
        <include domain="sharedpref" path="liferise_prefs.xml" />
        <exclude domain="sharedpref" path="liferise_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="liferise_database.db" />
        <include domain="sharedpref" path="liferise_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
